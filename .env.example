# API key for the multimodal AI provider (server-side only — never exposed to the browser).
# Anthropic keys: https://console.anthropic.com/settings/keys
# Google Gemini keys: https://aistudio.google.com/apikey
AI_API_KEY=

# Optional. Which provider implementation to use. Default: anthropic
# Supported: anthropic | gemini
#
# `gemini` has a free tier, at the cost of some accuracy on handwritten or
# dense notation. Note that Google may use free-tier requests to improve its
# models; paid Gemini keys are excluded from that.
# AI_PROVIDER=anthropic

# Optional. Overrides the model.
# Default for anthropic: claude-opus-5
# Default for gemini:    gemini-flash-latest
#
# Pin a Gemini version here only if you need one specific version: Google
# closes retired models to new API keys, so a pinned value can start returning
# 404 for anyone deploying with a fresh key.
# AI_MODEL=claude-opus-5

# Optional. Reasoning depth: low | medium | high | xhigh | max. Default: medium
# On gemini this maps to a thinking-token budget.
# AI_EFFORT=medium

# Optional. Repository link shown in the header.
# NEXT_PUBLIC_GITHUB_URL=https://github.com/your-name/math2latex
